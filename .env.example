# Local development only. Copy to .env; never use production credentials here.
# Host ports differ from go-api-template so both projects can run together.
PORT=8081
POSTGRES_PORT=5433
POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_password
POSTGRES_DB=authdb
# Used by make dev. Compose supplies its own URL using the db service name.
DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable"
DB_MAX_CONNS=5
